# TEMPORARY: Streamlit Community Cloud demo. Paste the filled-in version into the app's
# Settings -> Secrets on share.streamlit.io; never commit real values (secrets.toml is git-ignored).
# Root-level keys become environment variables, which planetary_defense.config.Settings reads.

NASA_API_KEY = "DEMO_KEY"

# Hosted PostgreSQL (e.g. Neon: Dashboard -> Connect -> "Parameters only")
DB_HOST = "ep-example-123456.eu-central-1.aws.neon.tech"
DB_PORT = "5432"
DB_NAME = "neondb"
DB_USER = "neondb_owner"
DB_PASSWORD = "paste-the-password-here"
DB_SSLMODE = "require"
