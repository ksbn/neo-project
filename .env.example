# Copy to .env and fill in real values: cp .env.example .env

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=neo_db
DB_USER=neo_user
DB_PASSWORD=change_me

# NASA API (get a free key at https://api.nasa.gov; DEMO_KEY works with low rate limits)
NASA_API_KEY=DEMO_KEY

# Optional: anomaly alert thresholds (defaults shown; LD = lunar distance, NeoWs convention)
# ALERT_CRITICAL_LD=1
# ALERT_WARNING_LD=5
# ALERT_WATCH_LD=10
# ALERT_HIGH_VELOCITY_KM_S=30
# ALERT_LARGE_DIAMETER_KM=1
# ALERT_HAZARDOUS_CLOSE_LD=20

# Optional: days a cached orbit (from NASA /neo/{id}) is used before asking NASA again
# ORBIT_CACHE_MAX_AGE_DAYS=30
